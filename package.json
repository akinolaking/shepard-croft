{
  "name": "shepard-croft-astryx",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-assets.mjs && tsc --noEmit && vite build && node scripts/build-seo.mjs && node scripts/audit-seo.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/*.test.js",
    "qa:visual": "node scripts/visual-qa.cjs",
    "seo:audit": "node scripts/audit-seo.mjs",
    "predev": "node scripts/build-assets.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.4",
    "@astryxdesign/theme-neutral": "0.7.4",
    "@stylexjs/stylex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@neondatabase/serverless": "1.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
