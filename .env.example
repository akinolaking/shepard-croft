# Supplied securely via the Vercel Neon integration; NEVER prefix with VITE_
SHPRD_DATABASE_URL=
# Keep disabled until migrations, privacy review and anti-abuse controls are complete.
SHPRD_BOOKING_REQUESTS_ENABLED=false
# VoxelBooking requires separate PHP 8.3+/MySQL 8+ hosting and configured customer consent.
VOXELBOOKING_BASE_URL=
VOXELBOOKING_BUSINESS_SLUG=
VOXELBOOKING_SERVICE_ID=
SHPRD_VOXELBOOKING_ENABLED=false

# SEO: leave preview noindex. Set true ONLY for an approved production domain.
SEO_SITE_URL=https://shepard-croft.vercel.app
SEO_INDEXABLE=false
# Only show the public booking link after VoxelBooking real E2E tests.
VITE_VOXEL_BOOKING_LIVE=false